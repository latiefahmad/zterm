<Application
    x:Class="Zterm.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#3FD0B4</Color>
            <Color x:Key="SystemAccentColorLight1">#5FDCC4</Color>
            <Color x:Key="SystemAccentColorLight2">#7FE6D2</Color>
            <Color x:Key="SystemAccentColorDark1">#2FB79D</Color>
            <Color x:Key="SystemAccentColorDark2">#249884</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
